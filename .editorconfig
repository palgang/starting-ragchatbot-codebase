# Shared editor settings so every file type is formatted consistently.
# Python is formatted by black (see pyproject.toml); this covers the rest.
root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,css,html,json,toml,yml,yaml,md,sh}]
indent_style = space
indent_size = 4
